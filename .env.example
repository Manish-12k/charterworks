# ── Supabase ────────────────────────────────────────────────
# Project Settings → API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Keep this one secret — server only, never exposed to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Razorpay ────────────────────────────────────────────────
# Dashboard → Settings → API Keys. Start with TEST mode keys (free, no real money moves).
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# ── Resend (free transactional email — booking confirmations) ─
RESEND_API_KEY=re_xxxxxxxxxxxx
NOTIFY_EMAIL_FROM=Charterworks <onboarding@resend.dev>
NOTIFY_EMAIL_TO=you@yourdomain.com

# ── Site ────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
